{
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git status:*)",
      "Bash(git diff)",
      "Bash(git diff:*)",
      "Bash(git log)",
      "Bash(git log:*)",
      "Bash(git branch)",
      "Bash(git branch:*)",
      "Bash(git rev-parse:*)",
      "Bash(git tag)",
      "Bash(git tag:*)",
      "Bash(./mvnw test)",
      "Bash(./mvnw test:*)",
      "Bash(mvnw test)",
      "Bash(mvnw test:*)",
      "Bash(flutter test)",
      "Bash(flutter test:*)"
    ],
    "deny": [
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git clean:*)",
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(del:*)",
      "PowerShell(Remove-Item:*)",
      "PowerShell(rd:*)",
      "Edit(**/*.env)",
      "Write(**/*.env)",
      "Edit(**/*.env.*)",
      "Write(**/*.env.*)",
      "Edit(**/secrets/**)",
      "Write(**/secrets/**)",
      "Edit(**/*.jks)",
      "Write(**/*.jks)",
      "Edit(**/*.keystore)",
      "Write(**/*.keystore)",
      "Edit(**/*.p12)",
      "Write(**/*.p12)",
      "Edit(**/*.pem)",
      "Write(**/*.pem)",
      "Edit(**/key.properties)",
      "Write(**/key.properties)",
      "Edit(**/google-services.json)",
      "Write(**/google-services.json)",
      "Edit(**/GoogleService-Info.plist)",
      "Write(**/GoogleService-Info.plist)",
      "Edit(**/credentials.json)",
      "Write(**/credentials.json)",
      "Edit(src/**)",
      "Write(src/**)",
      "Edit(pom.xml)",
      "Write(pom.xml)",
      "Edit(mvnw)",
      "Write(mvnw)",
      "Edit(mvnw.cmd)",
      "Write(mvnw.cmd)",
      "Edit(CLAUDE_backend.md)",
      "Write(CLAUDE_backend.md)"
    ],
    "defaultMode": "default"
  }
}
