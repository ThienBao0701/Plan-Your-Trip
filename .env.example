# INFRA-02 — environment template for the Docker Compose stack.
# Copy to `.env` (git-ignored) and replace every placeholder. NEVER commit a real .env.
#   cp .env.example .env
# Generate strong secrets, e.g.:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────────────────────

# ── SQL Server container ──────────────────────────────────────────────────────
# SA password policy: >=8 chars incl. upper/lower/digit/symbol, or SQL Server refuses to start.
MSSQL_SA_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD
# Edition: Developer (free, full features, NOT licensed for production) or Express (free, prod-OK, <=10GB/DB).
MSSQL_PID=Developer
# Application database name (Flyway owns everything inside it; db-init only CREATEs the database).
APP_DB_NAME=PlanYourTrip

# ── Spring datasource (app → db over the internal Docker network) ──────────────
# LOCAL verification uses the container's self-signed cert → trustServerCertificate=true.
# PRODUCTION: use a trusted certificate and set trustServerCertificate=false (see DEPLOYMENT.md §21).
SPRING_DATASOURCE_URL=jdbc:sqlserver://db:1433;databaseName=PlanYourTrip;encrypt=true;trustServerCertificate=true;sendStringParametersAsUnicode=true;loginTimeout=30
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=REPLACE_WITH_STRONG_SA_PASSWORD

# ── Application secrets (DB-06 fail-fast: app refuses to start if weak/missing) ─
# Both MUST be >=32 chars, NOT a placeholder, and STABLE across restarts.
JWT_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS
VOUCHER_SIGNING_SECRET=REPLACE_WITH_STRONG_SECRET_AT_LEAST_32_CHARS

# ── CORS ──────────────────────────────────────────────────────────────────────
# Same-origin (Nginx serves web + proxies /api) makes this near-moot. Set to the canonical
# public origin(s), comma-separated. No wildcard '*' (allowCredentials=true). Leave blank for
# pure same-origin local verification.
CORS_ALLOWED_ORIGIN_PATTERNS=

# ── Optional: initial admin bootstrap (both must be set, or the admin step is skipped) ─
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FULL_NAME=Administrator

# ── Web / runtime ─────────────────────────────────────────────────────────────
# Host port Nginx is published on (http://localhost:<port>). TLS terminates in front of this on a VPS.
WEB_HTTP_PORT=8088
# Path to the built Flutter Web bundle Nginx serves. Build with API_BASE_URL=/api (DEPLOYMENT.md §11),
# then point this at that build/web directory (relative to this file, or an absolute path).
WEB_ROOT=./web/build
# Optional JVM tuning for the app container.
JAVA_OPTS=-XX:MaxRAMPercentage=75
